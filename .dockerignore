!dify-integration-lab/DIFY_STUDENT_PROMPT.txt
!dify-integration-lab/public/
!dify-integration-lab/public/**
!admin-access/
!admin-access/*.mjs
!admin-access/public/
!admin-access/public/**
!admin-ai-design/
!admin-ai-design/DIFY_ADMIN_PROMPT.txt
!admin-ai-design/validate-response.js
!traffic-sandbox/
!traffic-sandbox/*.mjs
!traffic-sandbox/dist/
!traffic-sandbox/dist/**
!qa-policy/
!qa-policy/*.mjs
!campus-access/
!campus-access/server.mjs
**/private
**/private/**
**/.env*
**/*.pem
**/*.key
**/*.log
**/evidence
**/evidence/**
