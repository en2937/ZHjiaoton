{$PUBLIC_HOST} {
    encode zstd gzip
    header Strict-Transport-Security "max-age=31536000"
    request_body {
        max_size 32KB
    }
    reverse_proxy app:3000 {
        header_up Host {$PUBLIC_HOST}
        header_up X-Traffic-Edge-Key {$TRAFFIC_PROXY_KEY}
        header_up X-Traffic-Proto https
        header_up X-Traffic-Client-IP {remote_host}
        header_up -X-Internal-Proxy-Key
        header_up -X-Internal-Client-IP
        header_up -X-Admin-Control-Key
        header_up -X-Admin-View-Key
    }
}
